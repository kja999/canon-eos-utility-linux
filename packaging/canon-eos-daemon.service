[Unit]
Description=Canon EOS auto-sync daemon
Documentation=https://github.com/yourname/canon-eos-utility-linux
After=network-online.target avahi-daemon.service
Wants=network-online.target

[Service]
Type=simple
# Adjust to your install (e.g. ~/.local/bin/canon-eos-daemon or a venv path)
ExecStart=%h/.local/bin/canon-eos-daemon
Restart=on-failure
RestartSec=5
# Keep the process alive across camera power cycles:
#   systemctl --user import-environment
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
